@tool
class_name Stage
extends Node3D
## The arena: scenery plus two walls bounding world X. Each wall's inner face
## sits at ±`half_width`; its model extends `WALL_THICKNESS` outward. The
## walls are placed from `half_width` on ready, so change it here, not by
## moving the nodes. Display only: the `Match` turns `half_width` into the
## fighters' `wall_limit`.
##
## The street, its props and the wall pillar are `.glb`s generated by
## `stages/street/source/build_street.py`, loaded at runtime like characters
## (toon materials). Every scenery node named `steam*` gets a `steam_scene`
## emitter, puffing along the node's +Y.
##
## A tool script, so the editor shows the same scenery. The loaded nodes get
## no `owner`, so they are never saved into the scene file; reopen the scene
## to see a rebuilt `.glb` or changed paths.

## Visible thickness of each wall model (m), outside `half_width`; matches the
## pillar in `build_street.py`.
const WALL_THICKNESS := 0.5

## Distance from the stage center to each wall's inner face (m). Fighter body
## centers stop one body radius (0.3) short of it.
@export var half_width := 6.0
## Backdrop, street and props, in world coordinates (origin = stage center).
@export_file("*.glb") var scenery_path := "res://stages/street/street.glb"
## One wall, inner face at x = 0 extending to +x; mirrored for the left wall.
@export_file("*.glb") var wall_path := "res://stages/street/wall.glb"
## Spawned at each `steam*` marker in the scenery.
@export var steam_scene: PackedScene = preload("res://stages/steam.tscn")

@onready var wall_left: Node3D = $WallLeft
@onready var wall_right: Node3D = $WallRight


func _ready() -> void:
	wall_left.position.x = -half_width
	wall_right.position.x = half_width
	var scenery := CharacterLoader.load_glb(scenery_path)
	if scenery != null:
		add_child(scenery)
		for marker in scenery.find_children("steam*", "Node3D", true, false):
			marker.add_child(steam_scene.instantiate())
	for wall: Node3D in [wall_left, wall_right]:
		var model := CharacterLoader.load_glb(wall_path)
		if model == null:
			continue
		if wall == wall_left:
			model.scale.x = -1.0
		wall.add_child(model)


## How far from the center the stage is drawn: the walls' outer faces. A
## camera showing no more than this sees no empty space past the walls.
func outer_half_width() -> float:
	return half_width + WALL_THICKNESS
