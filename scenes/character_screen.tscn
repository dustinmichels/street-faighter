theme_override_font_sizes/font_size = 16
text = "STEP 1 OF 3: SAVE THE KIT"
horizontal_alignment = 1

[node name="Prompt" type="TextEdit" parent="ReviewPage/Items"]
unique_name_in_owner = true
custom_minimum_size = Vector2(440, 140)
layout_mode = 2
focus_mode = 1
tooltip_text = "The prompt for your AI agent. Up/down scroll it."
editable = false
context_menu_enabled = false
wrap_mode = 1

[node name="Status" type="Label" parent="ReviewPage/Items"]
unique_name_in_owner = true
custom_minimum_size = Vector2(440, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.58, 0.7, 1)
horizontal_alignment = 1
autowrap_mode = 1

[node name="Buttons" type="HBoxContainer" parent="ReviewPage/Items"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="ReviewBack" type="Button" parent="ReviewPage/Items/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "BACK"

[node name="SaveKit" type="Button" parent="ReviewPage/Items/Buttons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Write the creator kit folder, then show how to run your AI agent in it."
text = "SAVE KIT"

[node name="KitFolder" type="Button" parent="ReviewPage/Items/Buttons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Choose the folder creator kits are saved in."
