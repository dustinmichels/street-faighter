[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/character_screen.gd" id="1_screen"]
[ext_resource type="Script" path="res://scripts/character_wizard.gd" id="2_wizard"]
[ext_resource type="Script" path="res://scripts/character_preview.gd" id="3_preview"]

[node name="CharacterScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_screen")

[node name="LibraryPage" type="CenterContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Items" type="VBoxContainer" parent="LibraryPage"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

[node name="LibraryTitle" type="Label" parent="LibraryPage/Items"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.98, 0.82, 0.2, 1)
theme_override_font_sizes/font_size = 16
text = "CHARACTERS"
horizontal_alignment = 1

[node name="Body" type="HBoxContainer" parent="LibraryPage/Items"]
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
theme_override_constants/separation = 12

[node name="List" type="VBoxContainer" parent="LibraryPage/Items/Body"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

[node name="Library" type="ItemList" parent="LibraryPage/Items/Body/List"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 96)
layout_mode = 2

[node name="Fight" type="Button" parent="LibraryPage/Items/Body/List"]
unique_name_in_owner = true
visible = false
layout_mode = 2
tooltip_text = "Fight the computer with the selected character."
text = "FIGHT!"

[node name="Create" type="Button" parent="LibraryPage/Items/Body/List"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Answer a few questions to get a creator kit and a prompt for your AI agent."
text = "CREATE NEW"

[node name="Import" type="Button" parent="LibraryPage/Items/Body/List"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Import the character your agent exported for the last kit, or pick a .glb. You can also drop a .glb onto the window."
text = "IMPORT…"

[node name="Close" type="Button" parent="LibraryPage/Items/Body/List"]
unique_name_in_owner = true
layout_mode = 2
text = "BACK"

[node name="Entry" type="VBoxContainer" parent="LibraryPage/Items/Body"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

[node name="Preview" type="SubViewportContainer" parent="LibraryPage/Items/Body/Entry"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 104)
layout_mode = 2
script = ExtResource("3_preview")

[node name="Punch" type="Button" parent="LibraryPage/Items/Body/Entry"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Play the punch, to check that every part follows its bone."
text = "PUNCH"

[node name="Reimport" type="Button" parent="LibraryPage/Items/Body/Entry"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Import the selected character again from the file it came from."
disabled = true
text = "RE-IMPORT"

[node name="Delete" type="Button" parent="LibraryPage/Items/Body/Entry"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Remove the selected character from the library (its source file is kept)."
disabled = true
text = "DELETE"

[node name="LibraryStatus" type="Label" parent="LibraryPage/Items"]
unique_name_in_owner = true
custom_minimum_size = Vector2(332, 0)
layout_mode = 2
size_flags_horizontal = 4
theme_override_colors/font_color = Color(0.6, 0.58, 0.7, 1)
text = "IMPORT A .GLB, OR DROP ONE HERE"
horizontal_alignment = 1
autowrap_mode = 1

[node name="Hint" type="Label" parent="LibraryPage/Items"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.58, 0.7, 1)
text = "ESC: BACK"
horizontal_alignment = 1

[node name="WizardPage" type="CenterContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Wizard" type="VBoxContainer" parent="WizardPage"]
unique_name_in_owner = true
layout_mode = 2
